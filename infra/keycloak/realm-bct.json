{
  "realm": "bct",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "VIEWER", "description": "Lecture seule : tableau de bord, historique. Aucune action." },
      { "name": "OPERATOR", "description": "VIEWER + déclencher une réparation, résoudre un incident, corriger un diagnostic." },
      { "name": "ADMIN", "description": "OPERATOR + gestion des comptes et de la configuration (via la console Keycloak)." }
    ]
  },
  "clients": [
    {
      "clientId": "bct-frontend",
      "name": "BCT Supervision - frontend Angular",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200", "+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "rh",
      "enabled": true,
      "emailVerified": true,
      "email": "rh@example.local",
      "firstName": "RH",
      "lastName": "Lecture",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "dali1234", "temporary": false }],
      "realmRoles": ["VIEWER"]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@example.local",
      "firstName": "Op",
      "lastName": "Exploitation",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "dali1234", "temporary": false }],
      "realmRoles": ["OPERATOR"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.local",
      "firstName": "Admin",
      "lastName": "Plateforme",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "dali1234", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
