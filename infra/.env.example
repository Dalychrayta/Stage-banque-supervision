# Copier ce fichier en ".env" (même dossier) et remplacer les valeurs
# ci-dessous par de vraies valeurs générées localement — jamais celles-ci.
# ".env" est ignoré par git (voir .gitignore) : ces secrets ne doivent
# jamais être committés.
#
# Générer chaque valeur avec : openssl rand -base64 18   (ou -base64 48 pour JWT_SECRET)

# Mot de passe admin de Grafana (par défaut "admin", à changer aussi)
GRAFANA_ADMIN_PASSWORD=change-me

# Compte administrateur maître de Keycloak (console d'admin sur :8180).
# Keycloak gère désormais l'authentification, les comptes et les rôles
# (VIEWER / OPERATOR / ADMIN) — l'API Gateway ne fait plus que vérifier
# les jetons qu'il émet. Les 3 comptes de démo (viewer.bct / operator.bct
# / admin.bct) et leurs mots de passe sont dans keycloak/realm-bct.json
# (mots de passe de développement, à changer pour tout usage réel).
KEYCLOAK_ADMIN_PASSWORD=change-me

# Adresse publique de Keycloak, telle que le NAVIGATEUR la voit. Elle
# devient l'émetteur (iss) des jetons. En local, laisser localhost ;
# en production, mettre le vrai nom de domaine (ex. https://auth.bct.tn)
# — les services iront alors chercher les clés à cette même adresse.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Cible réelle surveillée (srv-002) : PlatformeBack, un projet EXTERNE à ce
# dépôt, conteneurisé pour que l'auto-remédiation puisse agir dessus.
# PLATFORMEBACK_PATH doit pointer vers le dossier de ce projet sur la machine.
PLATFORMEBACK_DB_PASSWORD=change-me
PLATFORMEBACK_PATH=../../../PlatformeBack

# Oracle : mot de passe SYS/SYSTEM (administration) + un compte dédié par
# service ("database per service" — chaque service ne voit que ses propres
# tables, jamais celles d'un autre).
ORACLE_SYS_PASSWORD=change-me
DISCOVERY_DB_PASSWORD=change-me
COLLECTOR_DB_PASSWORD=change-me
RCA_DB_PASSWORD=change-me
HEALING_DB_PASSWORD=change-me
